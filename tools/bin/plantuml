#!/usr/bin/env bash
# tools/bin/plantuml — wrapper para invocar plantuml.jar bundled en el repo.
#
# Permite que el binario `plantuml` esté disponible sin instalar el paquete
# del sistema. Funciona en Linux/macOS/Windows-Git-Bash.
#
# Resolución de rutas:
#   1. PLANTUML_JAR si está en env (override).
#   2. <repo>/tools/plantuml.jar (default — descargado por scripts/setup.sh).
#
# Resolución de Java:
#   1. JAVA_HOME/bin/java si está en env.
#   2. <repo>/tools/jre/bin/java si existe (JRE portable).
#   3. java en PATH del sistema.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

JAR="${PLANTUML_JAR:-$REPO_ROOT/tools/plantuml.jar}"

if [ ! -f "$JAR" ]; then
  echo "ERROR: plantuml.jar no encontrado en $JAR" >&2
  echo "       Ejecutar: bash scripts/setup.sh" >&2
  exit 1
fi

# Resolver Java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_BIN="$JAVA_HOME/bin/java"
elif [ -x "$REPO_ROOT/tools/jre/bin/java" ]; then
  JAVA_BIN="$REPO_ROOT/tools/jre/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVA_BIN="java"
else
  echo "ERROR: java no encontrado." >&2
  echo "       Instalar JRE 11+ o ejecutar: bash scripts/setup.sh" >&2
  exit 1
fi

# Headless por default (no abrir ventanas)
exec "$JAVA_BIN" -Djava.awt.headless=true -jar "$JAR" "$@"
