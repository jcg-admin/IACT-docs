' =============================================================================
' ESTILOS PLANTUML - IACT Call Center Analytics v4.0
' =============================================================================
' Archivo: plantuml_styles.iuml
' Versión: 4.0.0
' Fecha: 2026-01-06
' Uso: !include ../_static/plantuml_styles.iuml
' =============================================================================

' -----------------------------------------------------------------------------
' CONFIGURACIÓN GLOBAL
' -----------------------------------------------------------------------------
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
skinparam responseMessageBelowArrow true

' -----------------------------------------------------------------------------
' PALETA DE COLORES IACT
' -----------------------------------------------------------------------------
!define COLOR_PRIMARY #2563EB
!define COLOR_SECONDARY #7C3AED
!define COLOR_SUCCESS #059669
!define COLOR_WARNING #D97706
!define COLOR_DANGER #DC2626
!define COLOR_INFO #0891B2
!define COLOR_LIGHT #F3F4F6
!define COLOR_DARK #1F2937
!define COLOR_BORDER #E5E7EB

' Colores por Módulo
!define COLOR_AUTH #3B82F6
!define COLOR_USERS #8B5CF6
!define COLOR_ACCESS #EC4899
!define COLOR_PIPELINE #F59E0B
!define COLOR_REPORTS #10B981
!define COLOR_ALERTS #EF4444
!define COLOR_AUDIT #6366F1
!define COLOR_LOGS #64748B

' -----------------------------------------------------------------------------
' ESTILOS PARA DIAGRAMAS DE CASO DE USO
' -----------------------------------------------------------------------------
skinparam usecase {
    BackgroundColor COLOR_LIGHT
    BorderColor COLOR_PRIMARY
    BorderThickness 2
    FontColor COLOR_DARK
    FontSize 12
    ArrowColor COLOR_PRIMARY
}

skinparam actor {
    BackgroundColor COLOR_PRIMARY
    BorderColor COLOR_PRIMARY
    FontColor COLOR_DARK
    FontSize 11
}

' -----------------------------------------------------------------------------
' ESTILOS PARA DIAGRAMAS DE SECUENCIA
' -----------------------------------------------------------------------------
skinparam sequence {
    ArrowColor COLOR_PRIMARY
    ArrowFontColor COLOR_DARK
    ArrowFontSize 10

    LifeLineBorderColor COLOR_BORDER
    LifeLineBackgroundColor COLOR_LIGHT

    ParticipantBorderColor COLOR_PRIMARY
    ParticipantBackgroundColor #DBEAFE
    ParticipantFontColor COLOR_DARK
    ParticipantFontSize 11

    ActorBorderColor COLOR_PRIMARY
    ActorBackgroundColor COLOR_PRIMARY
    ActorFontColor COLOR_DARK

    BoxBorderColor COLOR_BORDER
    BoxBackgroundColor #F9FAFB

    DividerBorderColor COLOR_BORDER
    DividerBackgroundColor COLOR_LIGHT
    DividerFontColor COLOR_DARK

    GroupBorderColor COLOR_SECONDARY
    GroupBackgroundColor #EDE9FE
    GroupHeaderFontColor COLOR_DARK

    ReferenceBackgroundColor #FEF3C7
    ReferenceBorderColor COLOR_WARNING
}

' -----------------------------------------------------------------------------
' ESTILOS PARA DIAGRAMAS DE ACTIVIDAD
' -----------------------------------------------------------------------------
skinparam activity {
    BackgroundColor COLOR_LIGHT
    BorderColor COLOR_PRIMARY
    FontColor COLOR_DARK

    DiamondBackgroundColor #FEF3C7
    DiamondBorderColor COLOR_WARNING
    DiamondFontColor COLOR_DARK

    StartColor COLOR_SUCCESS
    EndColor COLOR_DANGER
    BarColor COLOR_DARK

    ArrowColor COLOR_PRIMARY
}

skinparam activityDiamond {
    BackgroundColor #FEF3C7
    BorderColor COLOR_WARNING
    FontColor COLOR_DARK
}

' -----------------------------------------------------------------------------
' ESTILOS PARA NOTAS
' -----------------------------------------------------------------------------
skinparam note {
    BackgroundColor #FFFBEB
    BorderColor COLOR_WARNING
    FontColor COLOR_DARK
    FontSize 10
}

' Notas especiales para restricciones CNST
skinparam noteBackgroundColor<<CNST>> #FEE2E2
skinparam noteBorderColor<<CNST>> COLOR_DANGER

skinparam noteBackgroundColor<<INFO>> #DBEAFE
skinparam noteBorderColor<<INFO>> COLOR_PRIMARY

skinparam noteBackgroundColor<<SUCCESS>> #D1FAE5
skinparam noteBorderColor<<SUCCESS>> COLOR_SUCCESS

' -----------------------------------------------------------------------------
' ESTILOS PARA COMPONENTES
' -----------------------------------------------------------------------------
skinparam component {
    BackgroundColor COLOR_LIGHT
    BorderColor COLOR_PRIMARY
    FontColor COLOR_DARK
}

skinparam database {
    BackgroundColor #DBEAFE
    BorderColor COLOR_PRIMARY
    FontColor COLOR_DARK
}

' -----------------------------------------------------------------------------
' ESTEREOTIPOS PERSONALIZADOS
' -----------------------------------------------------------------------------
' Actores (Agrupadores RBAC)
skinparam actor<<AGR_ADMIN>> {
    BackgroundColor COLOR_DANGER
    BorderColor COLOR_DANGER
}

skinparam actor<<AGR_OPERADOR>> {
    BackgroundColor COLOR_SUCCESS
    BorderColor COLOR_SUCCESS
}

skinparam actor<<AGR_AUDITOR>> {
    BackgroundColor COLOR_SECONDARY
    BorderColor COLOR_SECONDARY
}

skinparam actor<<SISTEMA>> {
    BackgroundColor COLOR_DARK
    BorderColor COLOR_DARK
}

' Participantes por tipo
skinparam participant<<Frontend>> {
    BackgroundColor #DBEAFE
    BorderColor COLOR_AUTH
}

skinparam participant<<Backend>> {
    BackgroundColor #D1FAE5
    BorderColor COLOR_SUCCESS
}

skinparam participant<<Service>> {
    BackgroundColor #EDE9FE
    BorderColor COLOR_SECONDARY
}

skinparam participant<<Database>> {
    BackgroundColor #FEF3C7
    BorderColor COLOR_WARNING
}

skinparam participant<<External>> {
    BackgroundColor #FEE2E2
    BorderColor COLOR_DANGER
}

' -----------------------------------------------------------------------------
' MACROS ÚTILES
' -----------------------------------------------------------------------------
' Nota de restricción CNST
!define CNST_NOTE(cnst, texto) note right #FEE2E2: **cnst**\ntexto

' Nota de información
!define INFO_NOTE(texto) note right #DBEAFE: texto

' Nota de éxito
!define SUCCESS_NOTE(texto) note right #D1FAE5: texto

' Base de datos IVR (readonly)
!define IVR_DB database "IVR\n<<MariaDB>>\n//readonly//" as IVR #FEE2E2

' Base de datos Analytics (read-write)
!define ANALYTICS_DB database "Analytics\n<<PostgreSQL>>\n//read-write//" as Analytics #D1FAE5

' Actor con agrupador
!define ACTOR_AGR(id, nombre) actor "id\nnombre" as id

' Participante Frontend
!define FRONTEND(nombre) participant "nombre" as nombre <<Frontend>>

' Participante Backend
!define BACKEND(nombre) participant "nombre" as nombre <<Backend>>

' Participante Service
!define SERVICE(nombre) participant "nombre" as nombre <<Service>>

' -----------------------------------------------------------------------------
' SEPARADORES Y ORGANIZADORES
' -----------------------------------------------------------------------------
!define SECTION(titulo) == titulo ==
!define SUBSECTION(titulo) -- titulo --

' -----------------------------------------------------------------------------
' COLORES PARA SWIMLANES
' -----------------------------------------------------------------------------
|#DBEAFE| Actor |
|#D1FAE5| Sistema |
|#EDE9FE| Servicio |
|#FEF3C7| Base de Datos |

' =============================================================================
' FIN DE ESTILOS
' =============================================================================
