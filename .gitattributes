###############################################################################
# CONFIGURACIÓN GLOBAL
###############################################################################
# Detectar texto automáticamente y normalizar a LF en el repositorio
* text=auto

###############################################################################
# DOCUMENTACIÓN SPHINX Y ARCHIVOS DE TEXTO (FORZAR LF)
###############################################################################
*.rst             text eol=lf
*.md              text eol=lf
*.py              text eol=lf diff=python
*.txt             text eol=lf
Makefile          text eol=lf
Vagrantfile       text eol=lf
.gitignore        text eol=lf
.readthedocs.yaml text eol=lf

###############################################################################
# ESTÁTICOS Y WEB (HTML/JS/CSS)
###############################################################################
*.html            text eol=lf
*.css             text eol=lf
*.js              text eol=lf
*.json            text eol=lf
*.map             text eol=lf

###############################################################################
# SCRIPTS Y AUTOMATIZACIÓN (CRÍTICO PARA LINUX/VAGRANT)
###############################################################################
*.sh              text eol=lf
diagnose_postgres.sh text eol=lf

###############################################################################
# DIAGRAMAS PUML
###############################################################################
*.puml            text eol=lf

###############################################################################
# BINARIOS Y MULTIMEDIA (PROTEGER DE CORRUPCIÓN)
###############################################################################
*.png             binary
*.jpg             binary
*.jpeg            binary
*.ico             binary
*.rar             binary
# SVG es XML, pero suele ser mejor tratarlo como binario para evitar cambios en IDs
*.svg             binary

###############################################################################
# SPHINX BUILD ARTIFACTS (ESTADO INTERNO)
###############################################################################
# Estos archivos en build/.doctrees deben ser tratados como binarios
*.doctree         binary
*.pickle          binary
*.inv             binary
.buildinfo        text eol=lf