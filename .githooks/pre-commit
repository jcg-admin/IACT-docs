#!/bin/bash
#
# Git Hook: pre-commit
# Purpose: Detect potentially sensitive information in staged content
#          before allowing the commit.
#
# Origin: TD-003 (technical-debt.md) — derived from TD-001 incident
#         (PROJECT_CONFIGURATION_REVIEW.md leaked sensitive info to git
#         history in 2026-04-23).
#
# Bypass: git commit --no-verify  (use only after manual review).
#
# Patterns checked (in staged content only — diff against HEAD):
#   1. Generic credential markers:
#        API_KEY=, SECRET=, PASSWORD=, TOKEN=, BEARER  (with values)
#        AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=
#   2. Private IPs / localhost with non-standard ports + paths.
#   3. Filenames historically associated with sensitive content.
#

set -uo pipefail

# Colors only when stderr is a TTY
if [[ -t 2 ]]; then
  C_RED='\033[1;31m'
  C_YEL='\033[1;33m'
  C_RESET='\033[0m'
else
  C_RED=''; C_YEL=''; C_RESET=''
fi

err()  { printf "${C_RED}pre-commit: %s${C_RESET}\n" "$1" >&2; }
warn() { printf "${C_YEL}pre-commit: %s${C_RESET}\n" "$1" >&2; }

# Skip if no commits yet (initial commit edge case handled below)
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  STAGED_DIFF=$(git diff --cached --diff-filter=ACMR -U0 HEAD)
else
  STAGED_DIFF=$(git diff --cached --diff-filter=ACMR -U0 \
                  $(git hash-object -t tree /dev/null))
fi

# Empty diff → nothing to check (probably mode-only changes)
if [[ -z "$STAGED_DIFF" ]]; then
  exit 0
fi

# Limit checks to added lines (those starting with '+ ' but not '+++ ')
ADDED=$(echo "$STAGED_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+')

found=0
fail() {
  err "Potentially sensitive content detected in staged changes:"
  err "  Pattern: $1"
  err "  Match  : $2"
  found=1
}

# 1. Credential markers with REAL-looking value:
#    - Requires 8+ alphanumeric/+/=/_/-/. chars after = (typical secret length).
#    - Skips lines where the marker is inside backticks/quotes/angle-brackets
#      (doc pattern showing the marker name, not a real value).
while IFS= read -r line; do
  # Strip backtick-enclosed markers (common in doc): `API_KEY=...`
  line_stripped=$(echo "$line" | sed -E 's/`[^`]*`//g')

  if echo "$line_stripped" | grep -qiE '\b(API_KEY|SECRET_KEY|PASSWORD|BEARER|TOKEN|AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|PRIVATE_KEY|JWT_SECRET)[[:space:]]*[=:][[:space:]]*[A-Za-z0-9_+/=.-]{8,}\b'; then
    # Skip if it's clearly a placeholder/example
    if ! echo "$line" | grep -qiE '\b(example|placeholder|<your|TODO|XXX|REDACTED|NOT_A_REAL|dummy|fake|sample)\b'; then
      fail "credential marker with real-looking value" "$(echo "$line" | head -c 120)"
    fi
  fi
done <<< "$ADDED"

# 2. Filenames flagged as historically sensitive
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
while IFS= read -r f; do
  case "$f" in
    PROJECT_CONFIGURATION_REVIEW.md|*.env|*.env.local|*credentials*|*secrets*)
      fail "sensitive filename" "$f"
      ;;
  esac
done <<< "$STAGED_FILES"

# 3. Detect long base64-looking strings (possible keys)
if echo "$ADDED" | grep -qE '[A-Za-z0-9+/]{60,}={0,2}'; then
  warn "Long base64-like string detected — verify manually it is not a key/secret."
fi

if [[ $found -ne 0 ]]; then
  err ""
  err "If this is a false positive, bypass with:  git commit --no-verify"
  err "If it is a real secret, do NOT bypass — use env vars / git-crypt / vault."
  err ""
  err "Reference: .thyrox/context/technical-debt.md TD-001..TD-003"
  exit 1
fi

exit 0
